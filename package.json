{
  "name": "filesyncex",
  "version": "6.6.2",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "pnpm build && pnpm --filter @filesyncex/server test",
    "dev:web": "pnpm --filter @filesyncex/web dev",
    "dev:server": "pnpm --filter @filesyncex/server dev",
    "start": "pnpm --filter @filesyncex/shell start",
    "package": "pnpm --filter @filesyncex/shell package",
    "package:linux": "FSEX_TARGET=linux pnpm --filter @filesyncex/shell package",
    "set-version": "node scripts/set-version.mjs"
  }
}
