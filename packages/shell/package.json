{
  "name": "@filesyncex/shell",
  "version": "6.0.0",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "filesyncex": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@filesyncex/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@yao-pkg/pkg": "^5.16.1",
    "rcedit": "^4.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "../../release",
    "assets": [
      "../web/dist/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ]
  }
}
